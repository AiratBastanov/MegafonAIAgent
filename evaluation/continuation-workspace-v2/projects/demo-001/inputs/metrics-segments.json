{
  "group_by": [
    "period",
    "segment"
  ],
  "period_column": "period",
  "synthetic": true,
  "missing_values": [
    "",
    "NA"
  ],
  "columns": {
    "period": {
      "type": "text",
      "unit": "registration_month"
    },
    "segment": {
      "type": "text",
      "unit": "self_reported_category"
    },
    "eligible": {
      "type": "integer",
      "unit": "users",
      "min": "0"
    },
    "activated": {
      "type": "integer",
      "unit": "users",
      "min": "0"
    },
    "retained_d28": {
      "type": "integer",
      "unit": "users",
      "min": "0"
    },
    "paid": {
      "type": "integer",
      "unit": "users",
      "min": "0"
    },
    "revenue_rub": {
      "type": "integer",
      "unit": "RUB",
      "min": "0"
    },
    "variable_cost_rub": {
      "type": "integer",
      "unit": "RUB",
      "min": "0"
    }
  },
  "metrics": [
    {
      "id": "activation_pct",
      "operation": "ratio",
      "numerator": [
        "activated"
      ],
      "denominator": [
        "eligible"
      ],
      "multiplier": "100",
      "unit": "%",
      "rounding": 2
    },
    {
      "id": "retention_pct",
      "operation": "ratio",
      "numerator": [
        "retained_d28"
      ],
      "denominator": [
        "eligible"
      ],
      "multiplier": "100",
      "unit": "%",
      "rounding": 2
    },
    {
      "id": "paid_pct",
      "operation": "ratio",
      "numerator": [
        "paid"
      ],
      "denominator": [
        "eligible"
      ],
      "multiplier": "100",
      "unit": "%",
      "rounding": 2
    },
    {
      "id": "revenue_rub",
      "operation": "sum",
      "numerator": [
        "revenue_rub"
      ],
      "unit": "RUB",
      "rounding": 2
    },
    {
      "id": "variable_cost_rub",
      "operation": "sum",
      "numerator": [
        "variable_cost_rub"
      ],
      "unit": "RUB",
      "rounding": 2
    }
  ],
  "constraints": [
    {
      "operation": "lte",
      "left": "activated",
      "right": "eligible"
    },
    {
      "operation": "lte",
      "left": "retained_d28",
      "right": "eligible"
    },
    {
      "operation": "lte",
      "left": "paid",
      "right": "eligible"
    }
  ]
}
