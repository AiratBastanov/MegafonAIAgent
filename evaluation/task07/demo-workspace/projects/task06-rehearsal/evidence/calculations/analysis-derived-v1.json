  "definitions": {
    "historical_contribution": {
      "formula": "revenue30 - variable30",
      "unit": "RUB per segment over first 30 days of each trial"
    },
    "pooled_paid_per_trial": {
      "formula": "100 * sum(paid30) / sum(trials)",
      "unit": "%"
    },
    "support_cost": {
      "formula": "support_minutes * hourly_cost / 60",
      "unit": "RUB/account/month"
    },
    "unit_contribution": {
      "formula": "price - infra - support_cost",
      "unit": "RUB/account/month"
    },
    "fixed_coverage_accounts": {
      "formula": "ceil(fixed / unit_contribution) if unit_contribution > 0 else null",
      "unit": "paying accounts"
    },
    "monthly_balance": {
      "formula": "accounts * unit_contribution - fixed",
      "unit": "RUB/month"
    },
    "conditional_setup_payback": {
      "formula": "setup / monthly_balance if monthly_balance > 0 else null",
      "unit": "months"
    }
